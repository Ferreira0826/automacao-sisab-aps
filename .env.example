# --- Caminhos na rede corporativa SES-DF ---
PASTA_CSV_SISAB=\\SERVIDOR\caminho\para\relatorios-sisab\sisab
PLANILHA_CONSOLIDADA=\\SERVIDOR\caminho\para\Praticas.xlsx
ABA_DESTINO=sisab
PREFIXO_CSV=RelAtvColetivaMB

# --- eCIEGES ---
ECIEGES_URL=https://ecieges
ECIEGES_USER=seu_usuario
ECIEGES_PASS=sua_senha
ECIEGES_FORM_NOME=SISAB
ECIEGES_ABA_IMPORT=sisab

# --- Execução ---
HEADLESS=true
TIMEOUT_MS=60000
MAX_RETRIES=3
RETRY_DELAY_S=10
PULAR_ECIEGES=false

# --- E-mail (Gmail API) - reaproveite credentials/token do robô e-Gestor ---
ENVIAR_EMAIL=true
EMAIL_DESTINO=seu_email@gmail.com
EMAIL_REMETENTE=seu_email@gmail.com
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
